package com.baml.gdot.recall.amps.parser;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;

import com.baml.gdot.commons.amps.MessageType;
import com.baml.gdot.recall.entity.RecallTicket;
import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;
import java.time.ZonedDateTime;

public class MessageParserHybridFormatSteps {

    private String hybridMessage;
    private RecallTicket parsedTicket;
    private MessageParser<RecallTicket> parser;

    @Given("a hybrid format message with JSON and metadata")
    public void a_hybrid_format_message_with_json_and_metadata() {
        // Create a hybrid message with JSON content and SOH-delimited metadata
        // SOH character represented as \u0001
        hybridMessage = "{" +
                "\"recallType\" : \"Lender Recall Exec on behalf\"," +
                "\"estimatedUSDNotional\" : \"\"," +
                "\"swapCurrency\" : \"USD\"," +
                "\"positionType\" : \"\"," +
                "\"USDNotional\" : \"\"," +
                "\"clientType\" : \"\"," +
                "\"D1Comment\" : \"\"," +
                "\"client\" : \"ALLOC_MARSH\"," +
                "\"currency\" : \"CNH\"," +
                "\"id\" : \"OrderId-2025_03_27_1143_LENDER_RECALL\"," +
                "\"owner\" : \"sally.oh\"," +
                "\"coperId\" : 410000862," +
                "\"SLComment\" : \"\"," +
                "\"ticker\" : \"600036.SH\"," +
                "\"clientSubType\" : \"\"," +
                "\"recallQty\" : 1000.0," +
                "\"requestor\" : \"sally.oh\"," +
                "\"fillPrice\" : 0.0," +
                "\"reqId\" : \"918e299b-a475-488c-9c72-75ca9f4e4e2d\"," +
                "\"market\" : \"CHINA\"," +
                "\"entryTime\" : \"2025-03-27T03:44:02.000817\"," +
                "\"origType\" : \"SFE\"," +
                "\"fillInstruction\" : \"\"," +
                "\"fund\" : \"ALLOC_MARSH\"," +
                "\"currentState\" : \"Created\"," +
                "\"effectiveDate\" : \"2025-03-27\"," +
                "\"fillQty\" : 0.0" +
                "}" +
                "\u0001AMPSSTAMP=20250321T135819.46352672Z\u0001" +
                "AMPSRECEIVED=1742855099463\u0001" + 
                "SEQUENCE=12345\u0001" + 
                "SOURCE=TestSource";
        
        // Initialize the parser for RecallTicket class
        parser = new MessageParser<>(MessageType.JSON, RecallTicket.class);
    }

    @When("I parse the message using MessageParser")
    public void i_parse_the_message_using_message_parser() throws Exception {
        // Use reflection to access the private method for testing
        java.lang.reflect.Method parseMethod = MessageParser.class.getDeclaredMethod("parseHybridFormat", String.class);
        parseMethod.setAccessible(true);
        
        parsedTicket = (RecallTicket) parseMethod.invoke(parser, hybridMessage);
    }

    @Then("the object should have the correct values from JSON content")
    public void the_object_should_have_the_correct_values_from_json_content() {
        assertNotNull("Parsed ticket should not be null", parsedTicket);
        assertEquals("OrderId-2025_03_27_1143_LENDER_RECALL", parsedTicket.getId());
        assertEquals("918e299b-a475-488c-9c72-75ca9f4e4e2d", parsedTicket.getReqId());
        assertEquals("Created", parsedTicket.getCurrentState());
        assertEquals("sally.oh", parsedTicket.getRequestor());
        assertEquals("600036.SH", parsedTicket.getTicker());
        assertEquals(1000.0, parsedTicket.getRecallQty(), 0.001);
        assertEquals(0.0, parsedTicket.getFillQty(), 0.001);
        assertEquals(0.0, parsedTicket.getFillPrice(), 0.001);
        assertEquals("Lender Recall Exec on behalf", parsedTicket.getRecallType());
        assertEquals("ALLOC_MARSH", parsedTicket.getClient());
        assertEquals("CNH", parsedTicket.getCurrency());
        assertEquals("sally.oh", parsedTicket.getOwner());
        assertEquals(410000862, parsedTicket.getCoperId());
        assertEquals("CHINA", parsedTicket.getMarket());
        assertEquals("ALLOC_MARSH", parsedTicket.getFund());
        assertEquals("USD", parsedTicket.getSwapCurrency());
        assertEquals("SFE", parsedTicket.getOrigType());
    }

    @Then("the object should have the correct values from metadata")
    public void the_object_should_have_the_correct_values_from_metadata() {
        assertNotNull("Parsed ticket should not be null", parsedTicket);
        assertEquals("20250321T135819.46352672Z", parsedTicket.getAmpsStamp());
        assertEquals(1742855099463L, parsedTicket.getAmpsReceived());
    }
}

