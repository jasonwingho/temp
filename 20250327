package com.baml.gdot.recall.amps.parser;

import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNotNull;

import com.baml.gdot.commons.amps.MessageType;
import com.baml.gdot.recall.entity.RecallTicket;
import org.junit.Test;

public class MessageParserTest {

    @Test
    public void testParseHybridFormat() throws Exception {
        // Create a hybrid message with JSON content and SOH-delimited metadata
        String hybridMessage = "{" +
                "\"id\":\"TEST123\"," +
                "\"reqId\":\"REQ-123\"," +
                "\"currentState\":\"New\"," +
                "\"requestor\":\"TestUser\"," +
                "\"ticker\":\"AAPL\"," +
                "\"recallQty\":100," +
                "\"fillQty\":0," +
                "\"fillPrice\":0.0" +
                "}" +
                "\u0001AMPSSTAMP=20250321T135819.46352672Z\u0001" +
                "AMPSRECEIVED=1742855099463\u0001" + 
                "SEQUENCE=12345\u0001" + 
                "SOURCE=TestSource";

        MessageParser<RecallTicket> parser = new MessageParser<>(MessageType.JSON, RecallTicket.class);
        
        // Use reflection to access the private method for testing
        java.lang.reflect.Method parseMethod = MessageParser.class.getDeclaredMethod("parseHybridFormat", String.class);
        parseMethod.setAccessible(true);
        
        RecallTicket parsedTicket = (RecallTicket) parseMethod.invoke(parser, hybridMessage);
        
        // Verify JSON content
        assertNotNull(parsedTicket);
        assertEquals("TEST123", parsedTicket.getId());
        assertEquals("REQ-123", parsedTicket.getReqId());
        assertEquals("New", parsedTicket.getCurrentState());
        assertEquals("TestUser", parsedTicket.getRequestor());
        assertEquals("AAPL", parsedTicket.getTicker());
        assertEquals(100, parsedTicket.getRecallQty());
        assertEquals(0, parsedTicket.getFillQty());
        assertEquals(0.0, parsedTicket.getFillPrice(), 0.001);
        
        // Verify metadata
        assertEquals("20250321T135819.46352672Z", parsedTicket.getAmpsStamp());
        assertEquals(1742855099463L, parsedTicket.getAmpsReceived());
    }
}

