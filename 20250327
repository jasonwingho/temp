    @Then("the object should have the correct values from metadata")
    public void the_object_should_have_the_correct_values_from_metadata() {
        assertNotNull("Parsed ticket should not be null", parsedTicket);
        assertEquals("20250321T135819.46352672Z", parsedTicket.getAmpsStamp());
        assertEquals(1742855099463L, parsedTicket.getAmpsReceived());
    }
    
    @Then("the resulting string should contain all expected JSON fields")
    public void the_resulting_string_should_contain_all_expected_json_fields() {
        assertNotNull("Converted JSON should not be null", convertedJson);
        assertTrue("Should contain the ID", convertedJson.contains("\"id\":\"OrderId-2025_03_28_TEST\"") 
                                        || convertedJson.contains("\"id\" : \"OrderId-2025_03_28_TEST\""));
        assertTrue("Should contain the reqId", convertedJson.contains("\"reqId\":\"test-req-id-123\"") 
                                         || convertedJson.contains("\"reqId\" : \"test-req-id-123\""));
        assertTrue("Should contain the currentState", convertedJson.contains("\"currentState\":\"New\"") 
                                              || convertedJson.contains("\"currentState\" : \"New\""));
        assertTrue("Should contain recallType", convertedJson.contains("\"recallType\":\"Lender Recall\"") 
                                           || convertedJson.contains("\"recallType\" : \"Lender Recall\""));
        assertTrue("Should contain the ticker", convertedJson.contains("\"ticker\":\"AAPL.NY\"") 
                                         || convertedJson.contains("\"ticker\" : \"AAPL.NY\""));
        assertTrue("Should contain recallQty", convertedJson.contains("\"recallQty\":500.0") 
                                        || convertedJson.contains("\"recallQty\" : 500.0"));
        assertTrue("Should contain fund", convertedJson.contains("\"fund\":\"TEST_FUND\"") 
                                    || convertedJson.contains("\"fund\" : \"TEST_FUND\""));
    }
    
    @Then("the resulting string should be valid JSON")
    public void the_resulting_string_should_be_valid_json() {
        try {
            // Create a new ObjectMapper to test if the string is valid JSON
            ObjectMapper objectMapper = new ObjectMapper();
            objectMapper.registerModule(new JavaTimeModule());
            
            // This will throw an exception if the JSON is invalid
            JsonNode jsonNode = objectMapper.readTree(convertedJson);
            
            // Also verify that the parsed JSON can be converted back to a RecallTicket
            RecallTicket parsedBack = objectMapper.treeToValue(jsonNode, RecallTicket.class);
            
            // Verify a few key fields to make sure the round-trip conversion works
            assertEquals(testRecallTicket.getId(), parsedBack.getId());
            assertEquals(testRecallTicket.getReqId(), parsedBack.getReqId());
            assertEquals(testRecallTicket.getCurrentState(), parsedBack.getCurrentState());
            assertEquals(testRecallTicket.getTicker(), parsedBack.getTicker());
            assertEquals(testRecallTicket.getRecallQty(), parsedBack.getRecallQty(), 0.001);
        } catch (Exception e) {
            fail("The converted string is not valid JSON: " + e.getMessage());
        }
    }
}

