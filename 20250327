    @Test
    public void testConvertObjectToJsonString() {
        // Create a RecallTicket object
        RecallTicket ticket = new RecallTicket();
        ticket.setId("TEST-ORDER-123");
        ticket.setReqId("test-req-123");
        ticket.setCurrentState("New");
        ticket.setRecallType("Lender Recall");
        ticket.setRecallQty(250.0);
        ticket.setFillQty(0.0);
        ticket.setTicker("MSFT.US");
        ticket.setCurrency("USD");
        ticket.setOwner("test.user");
        ticket.setRequestor("test.user");
        ticket.setFund("TEST_FUND");
        
        // Convert to JSON string
        MessageParser<RecallTicket> parser = new MessageParser<>(MessageType.JSON, RecallTicket.class);
        String jsonString = parser.toString(ticket);
        
        // Verify the string is not null or empty
        assertNotNull(jsonString);
        assertTrue(jsonString.length() > 0);
        
        // Verify it contains expected fields
        assertTrue(jsonString.contains("\"id\""));
        assertTrue(jsonString.contains("TEST-ORDER-123"));
        assertTrue(jsonString.contains("\"recallQty\""));
        assertTrue(jsonString.contains("250.0"));
        
        try {
            // Verify it's valid JSON by parsing it
            ObjectMapper objectMapper = new ObjectMapper();
            objectMapper.registerModule(new JavaTimeModule());
            JsonNode node = objectMapper.readTree(jsonString);
            
            // Verify some key properties
            assertEquals("TEST-ORDER-123", node.get("id").asText());
            assertEquals("test-req-123", node.get("reqId").asText());
            assertEquals("New", node.get("currentState").asText());
            assertEquals(250.0, node.get("recallQty").asDouble(), 0.001);
        } catch (Exception e) {
            fail("Failed to parse generated JSON: " + e.getMessage());
        }
    }
    
