    @Then("the object should have the correct values from JSON content")
    public void the_object_should_have_the_correct_values_from_json_content() {
        assertNotNull("Parsed ticket should not be null", parsedTicket);
        assertEquals("OrderId-2025_03_27_1143_LENDER_RECALL", parsedTicket.getId());
        assertEquals("918e299b-a475-488c-9c72-75ca9f4e4e2d", parsedTicket.getReqId());
