/**
 * Reconstructs transaction logs from all relevant topics.
 */
private void reconstructTransactionLogs() {
    try {
        // Clear transaction logs with synchronization
        synchronized(transactionLogs) {
            transactionLogs.clear();
        }
        
        LOGGER.info("Starting transaction log reconstruction from topics");
        
        // Step 1: Snap RECALL/TICKET/HISTORY topic
        loadTopicData(
            recallTicketHistoryClient,
            recallTicketHistoryTopicName,
            "RECALL_TICKET",
            MessageType.JSON,
            "RECALL/TICKET/HISTORY"
        );
        
        // Step 2: Snap RECALL/TO/OMS topic
        loadTopicData(
            recallToOmsClient,
            recallToOmsTopicName,
            "ORDER",
            MessageType.NVFIX,
            "RECALL/TO/OMS"
        );
        
        // Step 3: Snap OMS/TO/RECALL topic
        loadTopicData(
            omsToRecallClient,
            omsToRecallTopicName,
            "OMS_RESPONSE",
            MessageType.NVFIX,
            "OMS/TO/RECALL"
        );
            
        // Wait for all 3 topics to be loaded
        if (!initLatch.await(15, TimeUnit.MINUTES)) {
            LOGGER.error("Transaction log reconstruction incomplete after 15 minutes");
            LOGGER.warn("Continuing with partial transaction logs");
        } else {
            LOGGER.info("Transaction log reconstruction completed successfully");
        }
            
        // Log transaction log statistics
        logTransactionLogStatistics();
            
    } catch (Exception e) {
        LOGGER.error("Error during transaction log reconstruction", e);
    }
}
