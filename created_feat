public class TransactionLogEntry {

    private static final DateTimeFormatter LOG_TIME_FORMAT = DateTimeFormatter.ISO_INSTANT;

    // For transaction log reconstruction
    private final String orderId;
    private final String source;
    private final String state;
    private final Instant timestamp;
    private final Object message;
    
    // Additional fields for order reconstruction
    private final long recallQty;
    private final long fillQty;
    private final double fillPrice;
    private final String executionId;
    private final Character execType;

    public TransactionLogEntry(String orderId, String source, String state, Instant timestamp, 
                             Object message, long recallQty, long fillQty, double fillPrice, 
                             String executionId, Character execType) {
        this.orderId = orderId;
        this.source = source;
        this.state = state;
        this.timestamp = timestamp;
        this.message = message;
        this.recallQty = recallQty;
        this.fillQty = fillQty;
        this.fillPrice = fillPrice;
        this.executionId = executionId;
        this.execType = execType;
    }

    public String getOrderId() { return orderId; }

    public String getSource() { return source; }

    public String getState() { return state; }

    public Instant getTimestamp() { return timestamp; }

    public Object getMessage() { return message; }
    
    public long getRecallQty() { return recallQty; }
    
    public long getFillQty() { return fillQty; }
    
    public double getFillPrice() { return fillPrice; }
    
    public String getExecutionId() { return executionId; }
    
    public Character getExecType() { return execType; }

    @SuppressWarnings("unchecked")
    public <T> T getMessageAs(Class<T> type) {
        if (message == null) {
            return null;
        }
        return (T) message;
    }

    public boolean isFromSource(String sourceName) { return source.equals(sourceName); }

    public boolean hasState(String stateName) { return state.equals(stateName); }

    // true if this entry is newer, false otherwise
    public boolean isNewerThan(Instant other) { return other == null || timestamp.isAfter(other); }

    public boolean isNewerThan(TransactionLogEntry other) { return other == null || isNewerThan(other.getTimestamp()); }

    @Override
    public String toString() {
        return String.format("[%s] %s - %s (%s) - recallQty: %d, fillQty: %d, fillPrice: %.2f, execType: %s",
                LOG_TIME_FORMAT.format(timestamp),
                orderId,
                state != null ? state : "N/A",
                source,
                recallQty,
                fillQty,
                fillPrice,
                execType != null ? execType : 'N');
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        TransactionLogEntry that = (TransactionLogEntry) o;
        return Objects.equals(orderId, that.orderId) && 
               Objects.equals(source, that.source) && 
               Objects.equals(state, that.state) &&
               Objects.equals(timestamp, that.timestamp);
    }

    @Override
    public int hashCode() { 
        return Objects.hash(orderId, source, state, timestamp); 
    }

    /**
     * Builder class for creating TransactionLogEntry instances.
     */
    public static class Builder {
        private String orderId;
        private String source;
        private String state;
        private Instant timestamp;
        private Object message;
        private long recallQty;
        private long fillQty;
        private double fillPrice;
        private String executionId;
        private Character execType;

        public Builder orderId(String orderId) {
            this.orderId = orderId;
            return this;
        }

        public Builder source(String source) {
            this.source = source;
            return this;
        }

        public Builder state(String state) {
            this.state = state;
            return this;
        }

        public Builder timestamp(Instant timestamp) {
            this.timestamp = timestamp;
            return this;
        }

        public Builder message(Object message) {
            this.message = message;
            return this;
        }
        
        public Builder recallQty(long recallQty) {
            this.recallQty = recallQty;
            return this;
        }
        
        public Builder fillQty(long fillQty) {
            this.fillQty = fillQty;
            return this;
        }
        
        public Builder fillPrice(double fillPrice) {
            this.fillPrice = fillPrice;
            return this;
        }
        
        public Builder executionId(String executionId) {
            this.executionId = executionId;
            return this;
        }
        
        public Builder execType(Character execType) {
            this.execType = execType;
            return this;
        }

        public TransactionLogEntry build() {
            return new TransactionLogEntry(orderId, source, state, timestamp, message, 
                                         recallQty, fillQty, fillPrice, executionId, execType);
        }

        public static Builder builder() { return new Builder(); }
    }
}



