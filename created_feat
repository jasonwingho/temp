/**
 * Loads data from an AMPS topic into the transaction log.
 * This method extracts additional fields needed for order reconstruction.
 *
 * @param client The AMPS client to use
 * @param topicName The topic name to load from
 * @param bindingType The binding type to use
 * @param messageType The message type
 * @param sourceIdentifier The source identifier for transaction log entries
 * @param <T> The type of message
 */
private <T> void loadTopicData(
    HAAmpsClient client,
    String topicName,
    String bindingType,
    MessageType messageType,
    String sourceIdentifier) {

    try {
        LOGGER.info("Loading data from {} topic", topicName);
        
        TypedHandler<T> handler = new TypedHandler<>(
            (TypedBinder<T>) TypeBinderFactory.getTypeBinder(bindingType, messageType)) {
            
            @Override
            public void onMessage(T message) {
                if (message != null) {
                    // Extract common fields based on message type
                    String orderId = null;
                    String state = null;
                    Instant timestamp = null;
                    long recallQty = 0;
                    long fillQty = 0;
                    double fillPrice = 0.0;
                    String executionId = null;
                    Character execType = null;
                    
                    // Extract fields based on message type
                    if (message instanceof RecallTicket) {
                        RecallTicket ticket = (RecallTicket) message;
                        orderId = ticket.getId();
                        state = ticket.getCurrentState();
                        timestamp = ticket.getEntryTime() != null ? 
                            ticket.getEntryTime().toInstant() : Instant.now();
                        recallQty = ticket.getRecallQty();
                        fillQty = ticket.getFillQty();
                        fillPrice = ticket.getFillPrice();
                    } else if (message instanceof Order) {
                        Order order = (Order) message;
                        orderId = order.getOrderID();
                        state = order.getCurrentState() != null ? 
                            order.getCurrentState().toString() : "Unknown";
                        timestamp = order.getTransactTime() != null ? 
                            parseTransactTime(order.getTransactTime()) : Instant.now();
                        
                        // Extract execution info if available
                        ExecutionReport report = order.getFillRequest();
                        if (report != null) {
                            recallQty = order.getOrdQty();
                            fillQty = report.getCumQty();
                            fillPrice = report.getAvgPrice();
                            executionId = report.getExecId();
                            execType = report.getExecType();
                        } else {
                            recallQty = order.getOrdQty();
                        }
                        
                        // Extract amend request info if available
                        AmendRequest amendRequest = order.getAmendRequest();
                        if (amendRequest != null) {
                            recallQty = amendRequest.getOrderQty();
                            fillPrice = amendRequest.getPrice();
                        }
                    } else if (message instanceof ExecutionReport) {
                        ExecutionReport report = (ExecutionReport) message;
                        orderId = report.getOrigClOrdID();
                        state = report.getOrderState();
                        timestamp = report.getTransactTime() != null ? 
                            parseTransactTime(report.getTransactTime()) : Instant.now();
                        recallQty = report.getLeavesQty() + report.getCumQty();
                        fillQty = report.getCumQty();
                        fillPrice = report.getAvgPrice();
                        executionId = report.getExecId();
                        execType = report.getExecType();
                    }
                    
                    if (orderId != null) {
                        // Create the transaction log entry with all fields
                        TransactionLogEntry entry = TransactionLogEntry.Builder.builder()
                            .orderId(orderId)
                            .source(sourceIdentifier)
                            .state(state)
                            .timestamp(timestamp)
                            .message(message)
                            .recallQty(recallQty)
                            .fillQty(fillQty)
                            .fillPrice(fillPrice)
                            .executionId(executionId)
                            .execType(execType)
                            .build();
                        
                        // Add to transaction log for this order
                        synchronized(transactionLogs) {
                            List<TransactionLogEntry> entries = transactionLogs.computeIfAbsent(
                                orderId, k -> Collections.synchronizedList(new ArrayList<>()));
                            
                            synchronized(entries) {
                                entries.add(entry);
                            }
                        }
                    }
                }
            }
            
            @Override
            public void endOfSow(com.crankuptheamps.client.Message msg) {
                LOGGER.info("{} loading completed", topicName);
                initLatch.countDown();
            }
        };
        
        client.snap(topicName, "", handler);
        
    } catch (Exception e) {
        LOGGER.error("Error loading {} data", topicName, e);
        initLatch.countDown(); // Ensure latch is counted down even on error
    }
}



