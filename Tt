public class CacheRebuildStepDefs {

    @Mock
    private HAAmpsClient recallTicketClient;

    @Mock
    private HAAmpsClient recallToOmsClient;

    @Mock
    private HAAmpsClient omsToRecallClient;

    @Mock
    private OrderFixTransformer orderFixTransformer;

    @Mock
    private HAAmpsBuilder.SOWConfig omsToRecallSowConfig;

